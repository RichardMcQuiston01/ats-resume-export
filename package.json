{
  "name": "@richardmcquiston01/ats-resume-export",
  "version": "0.4.0",
  "description": "Framework agnostic TypeScript package for exporting a resume to an ATS (Applicant Tracking System) compatible format: DOCX, PDF, HTML, plain text, and JSON, plus ATS checks and pluggable validation.",
  "license": "Apache-2.0",
  "author": "Richard McQuiston <richard.mcquiston@gmail.com> (https://richardmcquiston.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/ats-resume-export.git"
  },
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/ats-resume-export/issues"
  },
  "homepage": "https://github.com/RichardMcQuiston01/ats-resume-export#readme",
  "keywords": [
    "resume",
    "cv",
    "ats",
    "applicant-tracking-system",
    "docx",
    "pdf",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./docx": {
      "import": {
        "types": "./dist/docx.d.ts",
        "default": "./dist/docx.js"
      },
      "require": {
        "types": "./dist/docx.d.cts",
        "default": "./dist/docx.cjs"
      }
    },
    "./pdf": {
      "import": {
        "types": "./dist/pdf.d.ts",
        "default": "./dist/pdf.js"
      },
      "require": {
        "types": "./dist/pdf.d.cts",
        "default": "./dist/pdf.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run ci",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "docx": "^9.0.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "docx": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/node": "26.6.2",
    "docx": "9.7.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.5",
    "globals": "17.12.0",
    "jszip": "3.10.2",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.8",
    "tsup": "8.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
